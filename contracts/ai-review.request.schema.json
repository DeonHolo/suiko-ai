{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editorial AI review request draft 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "content_id",
    "language",
    "baseline_revision",
    "candidate_revision",
    "policy_pack",
    "taxonomy",
    "current_metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "content_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "language": {
      "type": "string",
      "const": "en"
    },
    "baseline_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_revision": {
      "$ref": "#/$defs/revision"
    },
    "policy_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "version",
        "approval_reference",
        "rules"
      ],
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "approval_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "rules": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "title",
              "text",
              "priority"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "\\S"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "priority": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections",
        "tags"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/taxonomy_item"
          }
        },
        "tags": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/taxonomy_item"
          }
        }
      }
    },
    "current_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "tag_ids",
        "short_description"
      ],
      "properties": {
        "section_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80
        },
        "tag_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "short_description": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "segments"
      ],
      "properties": {
        "revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_id",
              "field",
              "text"
            ],
            "properties": {
              "segment_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "\\S"
              },
              "field": {
                "type": "string",
                "enum": [
                  "title",
                  "body",
                  "caption",
                  "production_notes",
                  "source_notes"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000,
                "pattern": "^[^\\r]*$"
              }
            }
          }
        }
      }
    },
    "taxonomy_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
